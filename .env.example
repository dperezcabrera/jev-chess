# Set ONE of these two keys. The app uses whichever is present.

# Vercel AI Gateway: https://vercel.com/ai-gateway (Jev was free there until 2026-09-25)
AI_GATEWAY_API_KEY=

# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional. Only needed when both keys are set: openrouter or vercel
JEV_PROVIDER=

# Optional. Defaults to jev-latest on OpenRouter and typesafe-ai/jev on Vercel
JEV_MODEL=
